{
  "manifest_version": 3,
  "name": "TruthLens AI",
  "version": "0.3.0",
  "description": "Check selected text with TruthLens AI.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["https://mwmjlaaiqogvjjgqlnwd.supabase.co/*"],
  "action": { "default_title": "TruthLens AI", "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": { "id": "truthlens-ai@example.com", "strict_min_version": "128.0" }
  }
}
